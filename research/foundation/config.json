{
  "model": {
    "vocab_size": 4096,
    "context_length": 1024,
    "layers": 4,
    "d_model": 256,
    "n_heads": 4,
    "d_ff": 1024,
    "position_embedding": "learned_absolute",
    "normalization": "pre_layernorm",
    "weight_tying": true,
    "dtype": "float32"
  },
  "train": {
    "rate": 0.0003,
    "penalty": 0.1,
    "clip": 1.0,
    "warm": 100,
    "decay": 10000,
    "floor": 0.1,
    "batch": 1,
    "accum": 1,
    "sequence": 256,
    "steps": 10000,
    "interval": 100,
    "eval": 2048,
    "lang": 1.0,
    "sft": 1.0,
    "time": 100,
    "seed": 2025
  }
}
